---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import BuiltFor from "../components/BuiltFor.astro";
import Features from "../components/Features.astro";
import ScreenshotGallery from "../components/ScreenshotGallery.astro";
import PronunciationDeepDive from "../components/PronunciationDeepDive.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import TechArchitecture from "../components/TechArchitecture.astro";
import DownloadSection from "../components/DownloadSection.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
---

<BaseLayout
  title="VietAccent — Dialect-Aware Vietnamese Pronunciation Learning"
  description="A free Android app with per-syllable pronunciation scoring (MFA + PhoWhisper + CREPE), 11 exercise types, and Hanoi/Saigon dialect support. VinUniversity capstone project."
>
  <Nav />
  <main>
    <Hero />
    <BuiltFor />
    <Features />
    <ScreenshotGallery />
    <PronunciationDeepDive />
    <VideoEmbed />
    <TechArchitecture />
    <DownloadSection
      version="v1.0.0"
      releaseDate="2026-06-05"
      sha256="d286ad7c5a1f15e840c8cd5d6793712dda1bcc864ecd833e317f4074791c5864"
      minAndroid="6.0 (API 23)"
    />
    <Faq />
  </main>
  <Footer />
  <Analytics />
</BaseLayout>

<script>
  // Track APK download clicks
  document.querySelectorAll("[id$='-download-apk'], [id='main-download-apk']").forEach((el) => {
    el.addEventListener("click", () => {
      if (typeof window !== "undefined" && (window as any).va) {
        (window as any).va("event", { name: "apk_download", data: { source: el.id } });
      }
    });
  });
</script>
