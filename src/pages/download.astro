---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import DownloadSection from "../components/DownloadSection.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
---

<BaseLayout
  title="Download VietAccent APK — Free Vietnamese Learning App"
  description="Download the VietAccent Android APK directly. Signed release, SHA-256 verified. Requires Android 6.0+. No Play Store account needed. Free forever."
  canonicalUrl="https://vietaccent.vercel.app/download"
>
  <Nav />
  <main class="pt-16">
    <DownloadSection
      version="v1.0.1"
      releaseDate="2026-06-21"
      sha256="0048a56104d746e0380133faed36122a1e3a8f16a2f9b6ed53c21c5260324d44"
      minAndroid="6.0 (API 23)"
    />

    <!-- Standalone trust note -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 text-center">
      <p class="text-sm" style="color: var(--color-text-secondary); font-family: var(--font-body);">
        Having trouble? Check the
        <a href="/#faq" style="color: var(--color-primary);" class="underline">FAQ</a>
        or
        <a href="mailto:vietaccent.admin@gmail.com" style="color: var(--color-primary);" class="underline">contact us</a>.
      </p>
    </div>
  </main>
  <Footer />
  <Analytics />
</BaseLayout>

<script>
  document.getElementById("main-download-apk")?.addEventListener("click", () => {
    if (typeof window !== "undefined" && (window as any).va) {
      (window as any).va("event", { name: "apk_download", data: { source: "download_page" } });
    }
  });
</script>
