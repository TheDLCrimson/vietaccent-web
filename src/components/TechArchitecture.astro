---
const stack = [
  {
    category: "Mobile",
    items: [
      { name: "Flutter", note: "iOS + Android + Web" },
      { name: "MVVM architecture", note: "Provider state management" },
      { name: "GetIt", note: "Dependency injection" },
    ],
  },
  {
    category: "Backend",
    items: [
      { name: "Django REST Framework", note: "Python API server" },
      { name: "Firebase Authentication", note: "Google Sign-In" },
      { name: "Firebase Firestore / Storage", note: "User data & assets" },
    ],
  },
  {
    category: "AI / Audio",
    items: [
      { name: "FFT tone analysis", note: "Pitch contour extraction" },
      { name: "Per-syllable scorer", note: "Custom scoring model" },
      { name: "Gemini AI", note: "Phrase explanations (backend)" },
      { name: "ElevenLabs TTS", note: "North/South accent audio" },
    ],
  },
  {
    category: "Quality",
    items: [
      { name: "435 automated tests", note: "Unit + integration + widget" },
      { name: "CI-ready", note: "Flutter test suite" },
    ],
  },
];

const badges = [
  "Flutter", "Dart", "Python", "Django", "Firebase",
  "Gemini AI", "ElevenLabs", "FFT", "MVVM", "Provider", "GetIt",
];
---

<section id="tech" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="inline-block bg-slate-200 text-slate-700 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
        For Recruiters
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Technical Architecture</h2>
      <p class="mt-4 text-lg text-slate-500 max-w-2xl mx-auto">
        VietAccent is a production-grade full-stack app, not a tutorial project. Here's what's under the hood.
      </p>
    </div>

    <!-- Stack badge strip -->
    <div class="flex flex-wrap gap-2 justify-center mb-12">
      {badges.map((b) => (
        <span class="bg-white border border-slate-200 text-slate-700 text-sm font-medium px-3 py-1 rounded-full shadow-sm">
          {b}
        </span>
      ))}
    </div>

    <!-- Detail grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {stack.map((s) => (
        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-widest text-red-600 mb-4">{s.category}</h3>
          <ul class="space-y-3">
            {s.items.map((item) => (
              <li class="flex flex-col">
                <span class="font-semibold text-slate-900 text-sm">{item.name}</span>
                <span class="text-xs text-slate-500">{item.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- GitHub CTA -->
    <div class="mt-12 text-center">
      <a
        href="https://github.com/Thanh-WuTan/vietaccent"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-slate-700 font-semibold hover:text-red-600 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        View source on GitHub →
      </a>
    </div>
  </div>
</section>
