---
const stack = [
  {
    category: "Mobile",
    items: [
      { name: "Flutter",   note: "Cross-platform UI toolkit" },
      { name: "MVVM",      note: "Provider state management" },
      { name: "GetIt",     note: "Dependency injection" },
    ],
  },
  {
    category: "Backend",
    items: [
      { name: "Django REST Framework", note: "Python API server" },
      { name: "PostgreSQL",            note: "Relational data store" },
      { name: "MinIO",                 note: "S3-compatible object storage" },
      { name: "Docker Swarm",          note: "Container orchestration" },
    ],
  },
  {
    category: "AI / Audio",
    items: [
      { name: "MFA (Kaldi)",       note: "Phone-level forced alignment" },
      { name: "PhoWhisper-small",  note: "Vietnamese ASR — VinAI fine-tune" },
      { name: "CREPE (torchcrepe)",note: "F0 pitch contour extraction" },
      { name: "OpenAI API",        note: "Phrase explanations (gpt-4o-mini)" },
      { name: "ElevenLabs TTS",   note: "Hanoi & Saigon accent audio" },
    ],
  },
  {
    category: "Quality",
    items: [
      { name: "232 backend tests",  note: "83% line coverage, Django test suite" },
      { name: "465+ mobile tests",  note: "Unit + widget + integration" },
      { name: "Firebase Auth",      note: "Google Sign-In for learners" },
    ],
  },
];

const badges = [
  "Flutter", "Dart", "Python", "Django REST", "PostgreSQL",
  "MinIO", "Docker Swarm", "MFA", "PhoWhisper", "CREPE",
  "OpenAI API", "ElevenLabs", "Firebase Auth", "MVVM", "Provider", "GetIt",
];
---

<section id="tech" class="py-24" style="background: var(--color-surface-alt);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        For Recruiters
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        Technical Architecture
      </h2>
      <p class="mt-4 text-base max-w-xl mx-auto" style="color: var(--color-text-secondary); font-family: var(--font-body);">
        A full-stack VinUniversity capstone — not a tutorial project. Flutter MVVM frontend, Django REST backend, a multi-signal speech pipeline, and 700+ tests across mobile and server.
      </p>
    </div>

    <!-- Badge strip -->
    <div class="flex flex-wrap gap-2 justify-center mb-12">
      {badges.map((b) => (
        <span
          class="text-sm font-medium px-3 py-1 rounded-full border"
          style="background: var(--color-surface); border-color: var(--color-border); color: var(--color-text-secondary); font-family: var(--font-display);"
        >
          {b}
        </span>
      ))}
    </div>

    <!-- Detail grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {stack.map((s) => (
        <div
          class="rounded-xl p-6 border"
          style="background: var(--color-surface); border-color: var(--color-border);"
        >
          <h3
            class="text-xs font-bold uppercase tracking-widest mb-4"
            style="color: var(--color-primary); font-family: var(--font-display);"
          >
            {s.category}
          </h3>
          <ul class="space-y-3">
            {s.items.map((item) => (
              <li>
                <span class="block font-semibold text-sm" style="font-family: var(--font-display); color: var(--color-text-primary);">{item.name}</span>
                <span class="text-xs" style="color: var(--color-text-muted); font-family: var(--font-body);">{item.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
