---
const steps = [
  { num: "01", title: "Record your voice",          detail: "Tap the microphone and say the target word or phrase. The app captures 16kHz mono audio in real time." },
  { num: "02", title: "Forced alignment (MFA)",     detail: "The Montreal Forced Aligner (Kaldi-based) maps your audio to the reference transcription at the phone level, producing per-phoneme timing and a goodness-of-pronunciation score for each segment." },
  { num: "03", title: "ASR check (PhoWhisper)",     detail: "PhoWhisper-small — VinAI's Vietnamese fine-tune of Whisper — transcribes what you actually said. A Needleman-Wunsch alignment then detects any mispronounced or skipped syllables." },
  { num: "04", title: "Pitch extraction (CREPE)",   detail: "CREPE (torchcrepe) extracts your F0 pitch contour per syllable and compares it against the reference tone curve. This is the primary signal for tone-class scoring." },
  { num: "05", title: "Score & feedback",           detail: "Per-syllable score = 0.6 × text_score + 0.4 × tone_score. A traffic-light indicator (green / yellow / red) gives instant at-a-glance feedback, and weak syllables are flagged for re-drill." },
];

const tones = [
  { name: "Flat (ngang)",    symbol: "a",  color: "#6366F1", desc: "Level mid tone" },
  { name: "Falling (huyền)", symbol: "à",  color: "#9C9C9C", desc: "Low falling" },
  { name: "Rising (sắc)",    symbol: "á",  color: "#22C55E", desc: "High rising" },
  { name: "Dipping (hỏi)",   symbol: "ả",  color: "#F59E0B", desc: "Dipping then rise" },
  { name: "Creaky (ngã)",    symbol: "ã",  color: "#F97316", desc: "High broken" },
  { name: "Heavy (nặng)",    symbol: "ạ",  color: "#EF4444", desc: "Low falling checked" },
];
---

<section id="pronunciation" class="py-24" style="background: var(--color-ink);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span
        class="inline-block text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-4"
        style="background: rgba(99,102,241,0.15); color: #A5B4FC; font-family: var(--font-display);"
      >
        Core Differentiator
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-white" style="font-family: var(--font-display);">
        Dialect-Aware Pronunciation Scoring
      </h2>
      <p class="mt-4 text-base max-w-2xl mx-auto leading-relaxed" style="color: #9C9C9C; font-family: var(--font-body);">
        Vietnamese has 6 tones — getting them wrong changes the word entirely. VietAccent fuses three independent signals (forced alignment, ASR, and pitch extraction) to give you objective, per-syllable feedback scored against the dialect you're learning.
      </p>
    </div>

    <!-- 6-tone reference -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-16">
      {tones.map((t) => (
        <div
          class="rounded-xl p-4 text-center border transition-colors duration-150"
          style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.08);"
        >
          <div class="text-3xl font-black mb-1 text-white" style="font-family: var(--font-display);">{t.symbol}</div>
          <div class="w-full h-0.5 rounded-full mb-2.5" style={`background: ${t.color};`}></div>
          <div class="text-xs font-semibold" style="color: rgba(255,255,255,0.75); font-family: var(--font-display);">{t.name}</div>
          <div class="text-xs mt-1" style="color: #6B6B6B;">{t.desc}</div>
        </div>
      ))}
    </div>

    <!-- Pipeline steps -->
    <h3 class="text-lg font-bold text-center mb-8" style="color: rgba(255,255,255,0.7); font-family: var(--font-display);">
      How the scoring pipeline works
    </h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {steps.map((s) => (
        <div class="rounded-xl p-5 border" style="background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.06);">
          <div class="text-xs font-bold mb-3" style="color: #6366F1; font-family: var(--font-mono);">{s.num}</div>
          <h4 class="font-bold text-white mb-2 text-sm" style="font-family: var(--font-display);">{s.title}</h4>
          <p class="text-xs leading-relaxed" style="color: #6B6B6B; font-family: var(--font-body);">{s.detail}</p>
        </div>
      ))}
    </div>

    <!-- Formula -->
    <div
      class="mt-12 rounded-xl p-6 border max-w-2xl mx-auto text-center"
      style="background: rgba(99,102,241,0.06); border-color: rgba(99,102,241,0.2);"
    >
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #6366F1; font-family: var(--font-display);">
        Per-syllable scoring formula
      </p>
      <code class="block text-base mb-3" style="color: #A5B4FC; font-family: var(--font-mono);">
        score = 0.6 × text_score + 0.4 × tone_score
      </code>
      <p class="text-sm" style="color: #6B6B6B; font-family: var(--font-body);">
        Text score comes from MFA forced alignment + PhoWhisper ASR. Tone score comes from CREPE F0 pitch contour matching. The weighted sum maps to a letter grade and a targeted re-drill suggestion.
      </p>
    </div>
  </div>
</section>
