---
const faqs = [
  {
    q: "Is the APK safe to install?",
    a: "Yes. The release APK is built with <code style=\"font-family:var(--font-mono);font-size:0.8em;background:var(--color-surface-alt);padding:1px 4px;border-radius:4px;\">flutter build apk --release</code> and signed with a dedicated keystore. The SHA-256 fingerprint on the download page lets you verify the file hasn't been tampered with before installing.",
  },
  {
    q: "Why isn't VietAccent on the Play Store?",
    a: "VietAccent is currently in open beta. Publishing to the Play Store adds review queues and ongoing compliance overhead that slows iteration. A direct APK lets beta testers and lecturers install the exact release being evaluated. A Play Store listing is planned once the app reaches production stability.",
  },
  {
    q: "Which Android version do I need?",
    a: "Android 6.0 (API level 23) or later — covering virtually all devices made in the last eight years. An iOS build exists in the codebase but is not yet distributed as a signed binary.",
  },
  {
    q: "Is my data private?",
    a: "Your account uses Firebase Authentication (Google Sign-In only — no passwords are stored by VietAccent). Audio you record for pronunciation scoring is processed server-side and is not retained after scoring. Progress and lesson data are stored in a PostgreSQL database linked to your account. See the full <a href='/privacy' style='color:var(--color-primary);text-decoration:underline;'>Privacy Policy</a> for details.",
  },
  {
    q: "Is VietAccent free?",
    a: "Completely free — no in-app purchases, no subscription, no ads. VietAccent is a VinUniversity capstone project built for research and education.",
  },
  {
    q: "Which dialect does VietAccent use?",
    a: "Both. You can choose Hanoi (Northern) or Saigon (Southern) as your pronunciation target when you start a lesson, and the scoring pipeline evaluates your speech against that dialect specifically. Phrase Explorer also streams native-quality audio for both accents via ElevenLabs TTS.",
  },
];
---

<section id="faq" class="py-24" style="background: var(--color-surface-alt);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        FAQ
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        Frequently asked questions
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border);" name="faq">
          <summary
            class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold transition-colors duration-150"
            style="font-family: var(--font-display); color: var(--color-text-primary);"
            onmouseover="this.style.color='var(--color-primary)'"
            onmouseout="this.style.color='var(--color-text-primary)'"
          >
            {faq.q}
            <svg class="w-4 h-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              style="color: var(--color-text-muted);"
              fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div
            class="px-6 pb-6 text-sm leading-relaxed"
            style="color: var(--color-text-secondary); font-family: var(--font-body);"
            set:html={faq.a}
          />
        </details>
      ))}
    </div>
  </div>
</section>
