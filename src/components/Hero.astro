---
const APK_URL = "https://github.com/Thanh-WuTan/vietaccent/releases/latest/download/app-release.apk";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
  style="background: var(--color-ink);"
>
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>
  <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] rounded-full opacity-20 blur-[120px] pointer-events-none"
    style="background: radial-gradient(circle, #6366F1, transparent 70%)"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] rounded-full opacity-15 blur-[100px] pointer-events-none"
    style="background: radial-gradient(circle, #F97316, transparent 70%)"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full mb-8 border"
          style="background: rgba(99,102,241,0.12); border-color: rgba(99,102,241,0.3); color: #A5B4FC;">
          <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1] animate-pulse"></span>
          Hanoi &amp; Saigon · Free · Android 6.0+
        </div>

        <h1
          class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.05] text-white"
          style="font-family: var(--font-display); letter-spacing: -0.04em;"
        >
          Vietnamese<br />
          pronunciation<br />
          <span style="color: #818CF8;">done right.</span>
        </h1>

        <p class="mt-6 text-lg max-w-lg mx-auto lg:mx-0 leading-relaxed" style="color: #9C9C9C; font-family: var(--font-body);">
          The only Vietnamese learning app that scores your pronunciation separately against <strong style="color: #e5e7eb;">Hanoi</strong> and <strong style="color: #e5e7eb;">Saigon</strong> — syllable by syllable, tone by tone.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a
            href={APK_URL}
            id="hero-download-apk"
            download
            class="inline-flex items-center justify-center gap-2.5 text-white font-bold px-8 py-4 rounded-lg text-base transition-all duration-150 hover:-translate-y-0.5"
            style="background: var(--color-primary); font-family: var(--font-display); box-shadow: 0 8px 30px rgba(99,102,241,0.4);"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download APK
          </a>
          <a
            href="#demo"
            class="inline-flex items-center justify-center gap-2 font-semibold px-8 py-4 rounded-lg text-base border transition-all duration-150 hover:-translate-y-0.5"
            style="color: #A5B4FC; border-color: rgba(99,102,241,0.3); background: rgba(99,102,241,0.06); font-family: var(--font-display);"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            Watch Demo
          </a>
        </div>

        <p class="mt-4 text-sm" style="color: var(--color-text-muted);">
          No Play Store account · No ads · No subscription
        </p>
      </div>

      <!-- Device mockup -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative w-60 sm:w-68">
          <div
            class="relative rounded-[2.5rem] p-3 shadow-2xl"
            style="background: #1a1a2e; box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.08);"
          >
            <div class="absolute top-3 left-1/2 -translate-x-1/2 w-16 h-1 rounded-full" style="background: #2a2a4a;"></div>
            <div class="rounded-[2rem] overflow-hidden aspect-[9/19]" style="background: #0C0B1A;">
              <div class="w-full h-full flex flex-col p-5 text-white">
                <div class="flex items-center gap-2 mb-5">
                  <div class="w-7 h-7 rounded-full flex items-center justify-center" style="background: rgba(99,102,241,0.2);">
                    <svg class="w-4 h-4 text-[#818CF8]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 15c1.66 0 3-1.34 3-3V6c0-1.66-1.34-3-3-3S9 4.34 9 6v6c0 1.66 1.34 3 3 3z"/>
                      <path d="M17 12c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-2.08c3.39-.49 6-3.39 6-6.92h-2z"/>
                    </svg>
                  </div>
                  <span class="text-xs font-semibold" style="color: #A5B4FC; font-family: var(--font-display);">Pronunciation</span>
                  <span class="ml-auto text-xs px-2 py-0.5 rounded-full" style="background: rgba(99,102,241,0.2); color: #818CF8;">Hanoi</span>
                </div>

                <div class="text-center mb-5">
                  <div class="text-3xl font-black mb-1" style="font-family: var(--font-display); color: #818CF8;">xin chào</div>
                  <div class="text-xs" style="color: var(--color-text-muted);">hello / good morning</div>
                </div>

                <div class="flex justify-center mb-5">
                  <div class="w-20 h-20 rounded-full flex items-center justify-center border-4" style="border-color: #6366F1; background: rgba(99,102,241,0.1);">
                    <div>
                      <div class="text-2xl font-black text-white text-center" style="font-family: var(--font-display);">88</div>
                      <div class="text-xs text-center" style="color: #818CF8;">/ 100</div>
                    </div>
                  </div>
                </div>

                <div class="space-y-2.5">
                  {[{ label: "xin", score: 92, color: "#22C55E" }, { label: "chào", score: 79, color: "#F59E0B" }].map(s => (
                    <div>
                      <div class="flex justify-between text-xs mb-1">
                        <span class="font-semibold" style="font-family: var(--font-display);">{s.label}</span>
                        <span style={{ color: s.color }}>{s.score}%</span>
                      </div>
                      <div class="h-1.5 rounded-full w-full" style="background: rgba(255,255,255,0.08);">
                        <div class="h-1.5 rounded-full" style={`width: ${s.score}%; background: ${s.color};`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="absolute inset-x-8 bottom-0 h-20 blur-2xl opacity-30 -z-10 rounded-full"
            style="background: #6366F1;"></div>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0 h-24 pointer-events-none"
    style="background: linear-gradient(to bottom, transparent, var(--color-bg));"></div>
</section>
