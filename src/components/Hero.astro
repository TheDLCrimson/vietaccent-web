---
const APK_URL = "https://github.com/TheDLCrimson/vietaccent-web/releases/latest/download/app-release.apk";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
  style="background: var(--color-ink);"
>
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>
  <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] rounded-full opacity-20 blur-[120px] pointer-events-none"
    style="background: radial-gradient(circle, #6366F1, transparent 70%)"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] rounded-full opacity-15 blur-[100px] pointer-events-none"
    style="background: radial-gradient(circle, #F97316, transparent 70%)"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32">
    <div class="grid lg:grid-cols-[1fr_2.5fr] gap-4 items-center">

      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full mb-8 border"
          style="background: rgba(99,102,241,0.12); border-color: rgba(99,102,241,0.3); color: #A5B4FC;">
          <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1] animate-pulse"></span>
          Hanoi &amp; Saigon · Free · Android 6.0+
        </div>

        <h1
          class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[1.05] text-white"
          style="font-family: var(--font-display); letter-spacing: -0.04em;"
        >
          Vietnamese<br />
          pronunciation<br />
          <span style="color: #818CF8;">done right.</span>
        </h1>

        <p class="mt-6 text-lg max-w-lg mx-auto lg:mx-0 leading-relaxed" style="color: #9C9C9C; font-family: var(--font-body);">
          The only Vietnamese learning app that scores your pronunciation separately against <strong style="color: #e5e7eb;">Hanoi</strong> and <strong style="color: #e5e7eb;">Saigon</strong> — syllable by syllable, tone by tone.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a
            href={APK_URL}
            id="hero-download-apk"
            download
            class="inline-flex items-center justify-center gap-2.5 text-white font-bold px-8 py-4 rounded-lg text-base transition-all duration-150 hover:-translate-y-0.5"
            style="background: var(--color-primary); font-family: var(--font-display); box-shadow: 0 8px 30px rgba(99,102,241,0.4);"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download APK
          </a>
          <a
            href="#demo"
            class="inline-flex items-center justify-center gap-2 font-semibold px-8 py-4 rounded-lg text-base border transition-all duration-150 hover:-translate-y-0.5"
            style="color: #A5B4FC; border-color: rgba(99,102,241,0.3); background: rgba(99,102,241,0.06); font-family: var(--font-display);"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            Watch Demo
          </a>
        </div>

        <p class="mt-4 text-sm" style="color: var(--color-text-muted);">
          No Play Store account · No ads · No subscription
        </p>
      </div>

      <!-- Device mockup -->
      <div class="flex justify-center lg:justify-end">
        <div class="hero-mockup-wrap relative w-full lg:w-[160%]">
          <img
            src="/assets/hero-mockup.png"
            alt="VietAccent app — pronunciation scoring on Hanoi and Saigon dialects"
            class="hero-mockup w-full h-auto relative z-10"
            loading="eager"
            decoding="async"
            width="800"
            height="900"
          />
          <!-- Ambient glow under the phones -->
          <div class="absolute bottom-4 inset-x-12 h-16 blur-3xl opacity-40 pointer-events-none rounded-full"
            style="background: linear-gradient(90deg, #6366F1, #F97316);"></div>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0 h-24 pointer-events-none"
    style="background: linear-gradient(to bottom, transparent, var(--color-bg));"></div>
</section>

<style>
  @keyframes hero-float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%       { transform: translateY(-16px) rotate(0.4deg); }
  }

  .hero-mockup {
    animation: hero-float 6s ease-in-out infinite;
    mix-blend-mode: screen;
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.5));
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mockup { animation: none; }
  }
</style>
