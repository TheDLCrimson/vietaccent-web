---
const APK_URL = "https://github.com/Thanh-WuTan/vietaccent/releases/latest/download/app-release.apk";
const DEMO_URL = "#demo";
---

<section id="hero" class="relative pt-24 pb-16 sm:pt-32 sm:pb-24 overflow-hidden bg-gradient-to-br from-red-50 via-white to-yellow-50">
  <!-- Background decorative element -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-red-100 opacity-40 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-yellow-100 opacity-40 blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text column -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-red-100 text-red-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
          <span>🎓</span> Open-source · Free to use
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-tight">
          Learn Vietnamese.<br />
          <span class="text-red-600">Sound like a native.</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-xl mx-auto lg:mx-0">
          VietAccent gives you structured lessons, AI-powered per-syllable pronunciation scoring with tone analysis, and an audio phrase explorer — all in one free mobile app.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href={APK_URL}
            id="hero-download-apk"
            download
            class="inline-flex items-center justify-center gap-2 bg-red-600 text-white font-bold px-8 py-4 rounded-xl text-lg hover:bg-red-700 transition-colors shadow-lg shadow-red-200"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download APK
          </a>
          <a
            href={DEMO_URL}
            class="inline-flex items-center justify-center gap-2 bg-white text-slate-800 font-semibold px-8 py-4 rounded-xl text-lg border border-slate-200 hover:border-red-300 hover:text-red-600 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            Watch Demo
          </a>
        </div>

        <p class="mt-4 text-sm text-slate-500">
          Android 6.0+ &nbsp;·&nbsp; Free &nbsp;·&nbsp; No Play Store account needed
        </p>
      </div>

      <!-- Screenshot column -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative w-64 sm:w-72">
          <!-- Device frame -->
          <div class="relative bg-slate-900 rounded-[2.5rem] p-3 shadow-2xl shadow-slate-400/50">
            <div class="absolute top-3 left-1/2 -translate-x-1/2 w-20 h-1.5 bg-slate-700 rounded-full"></div>
            <div class="bg-slate-100 rounded-[2rem] overflow-hidden aspect-[9/19]">
              <!-- Hero screenshot placeholder -->
              <div class="w-full h-full bg-gradient-to-b from-red-600 to-red-800 flex flex-col items-center justify-center text-white p-6">
                <div class="text-5xl mb-4">🎤</div>
                <div class="text-2xl font-bold mb-2">Pronunciation</div>
                <div class="text-sm opacity-80 text-center mb-6">Per-syllable AI scoring with tone analysis</div>
                <!-- Fake score bars -->
                <div class="w-full space-y-3">
                  {["Tốt", "Đẹp", "Ngon"].map((word, i) => (
                    <div class="flex items-center gap-3">
                      <span class="text-sm w-10 text-right font-medium">{word}</span>
                      <div class="flex-1 bg-white/20 rounded-full h-3">
                        <div
                          class="h-3 rounded-full bg-green-400"
                          style={`width: ${[85, 72, 91][i]}%`}
                        ></div>
                      </div>
                      <span class="text-sm font-bold">{[85, 72, 91][i]}%</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <!-- Decorative glow -->
          <div class="absolute inset-0 -z-10 bg-red-400 blur-3xl opacity-20 rounded-full scale-75 translate-y-4"></div>
        </div>
      </div>
    </div>
  </div>
</section>
