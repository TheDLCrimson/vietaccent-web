---
const SVG = (paths: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const audiences = [
  {
    icon: SVG(`<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>`),
    title: "Students",
    description: "Structured lessons + instant per-syllable pronunciation feedback. Pick Hanoi or Saigon and get scored against the right target.",
  },
  {
    icon: SVG(`<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`),
    title: "Teachers",
    description: "Assign as a self-study companion. Students practise tone accuracy between classes and arrive with measurable data.",
  },
  {
    icon: SVG(`<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>`),
    title: "Travelers",
    description: "Heading to Hanoi or Ho Chi Minh City? Learn to say it right before you land, and know which accent to expect when you get there.",
  },
  {
    icon: SVG(`<circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`),
    title: "Heritage Learners",
    description: "Most apps only teach Northern Vietnamese. VietAccent treats Hanoi and Saigon as equal first-class targets.",
  },
];
---

<section id="built-for" class="py-24" style="background: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        Who it's for
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        Built for everyone who needs Vietnamese
      </h2>
      <p class="mt-4 text-base max-w-xl mx-auto" style="color: var(--color-text-secondary); font-family: var(--font-body);">
        Whether you're a beginner, a teacher, a recruiter, or a heritage speaker: VietAccent has something for you.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {audiences.map((a) => (
        <div
          class="rounded-xl p-6 border transition-all duration-200 hover:-translate-y-0.5 cursor-default"
          style="background: var(--color-surface); border-color: var(--color-border);"
          onmouseover="this.style.boxShadow='0 8px 30px rgba(0,0,0,0.08)'; this.style.borderColor='rgba(99,102,241,0.3)';"
          onmouseout="this.style.boxShadow='none'; this.style.borderColor='var(--color-border)';"
        >
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style="background: rgba(99,102,241,0.1); color: #6366F1;" set:html={a.icon}></div>
          <h3 class="font-bold mb-2 text-base" style="font-family: var(--font-display); color: var(--color-text-primary);">{a.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary); font-family: var(--font-body);">{a.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
