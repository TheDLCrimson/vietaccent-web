---
const audiences = [
  {
    emoji: "📚",
    title: "Students",
    description:
      "Build a solid Vietnamese foundation with structured lessons across grammar, vocabulary, and listening. The pronunciation scorer gives you instant, objective feedback — no native speaker required.",
  },
  {
    emoji: "👨‍🏫",
    title: "Teachers",
    description:
      "Recommend VietAccent as a self-study companion. Students can drill tones between classes and arrive with measurable pronunciation data, letting you focus on higher-level fluency work.",
  },
  {
    emoji: "💼",
    title: "Recruiters",
    description:
      "VietAccent is a full-stack mobile project: Flutter MVVM frontend, Django REST backend, Firebase Auth, a speech-processing pipeline, and 435 automated tests. A concrete portfolio piece, not a toy app.",
  },
  {
    emoji: "🔬",
    title: "Researchers",
    description:
      "The open-source FFT-based tone contour analysis and per-syllable scoring pipeline serve as a reproducible baseline for Vietnamese pronunciation research and TTS evaluation.",
  },
];
---

<section id="built-for" class="py-24" style="background: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        Who it's for
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        Built for everyone who needs Vietnamese
      </h2>
      <p class="mt-4 text-base max-w-xl mx-auto" style="color: var(--color-text-secondary); font-family: var(--font-body);">
        Whether you're just starting out or evaluating the engineering behind it, VietAccent has something for you.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {audiences.map((a) => (
        <div
          class="rounded-xl p-6 border transition-all duration-200 hover:-translate-y-0.5 cursor-default group"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: none;"
          onmouseover="this.style.boxShadow='0 8px 30px rgba(0,0,0,0.08)'; this.style.borderColor='rgba(99,102,241,0.3)';"
          onmouseout="this.style.boxShadow='none'; this.style.borderColor='var(--color-border)';"
        >
          <div class="text-3xl mb-4">{a.emoji}</div>
          <h3 class="font-bold mb-2 text-base" style="font-family: var(--font-display); color: var(--color-text-primary);">{a.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary); font-family: var(--font-body);">{a.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
