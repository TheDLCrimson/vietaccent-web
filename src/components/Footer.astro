---
const year = new Date().getFullYear();
---

<footer style="background: var(--color-ink); color: var(--color-text-muted);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 font-bold text-lg" style="font-family: var(--font-display);">
        <img src="/assets/appicon_foreground.png" alt="VietAccent logo" class="w-8 h-8" />
        <span class="text-white">VietAccent</span>
      </a>

      <!-- Links -->
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm" style="font-family: var(--font-body);">
        <a href="/privacy"   class="hover:text-white transition-colors duration-150">Privacy</a>
        <a href="/terms"     class="hover:text-white transition-colors duration-150">Terms</a>
        <a href="/changelog" class="hover:text-white transition-colors duration-150">Changelog</a>
        <a href="mailto:vietaccent.admin@gmail.com" class="hover:text-white transition-colors duration-150">Contact</a>
      </nav>

      <!-- Copyright -->
      <p class="text-xs" style="color: #6B6B6B; font-family: var(--font-body);">
        © {year} VietAccent | VinUniversity Capstone Project.<br class="sm:hidden" /> All rights reserved.
      </p>
    </div>
  </div>
</footer>
