---
interface Props {
  version?: string;
  releaseDate?: string;
  sha256?: string;
  minAndroid?: string;
}

const {
  version    = "v1.0.0",
  releaseDate= "2025-06-05",
  sha256     = "run: certutil -hashfile app-release.apk SHA256",
  minAndroid = "6.0 (API 23)",
} = Astro.props;

const APK_URL = "https://github.com/TheDLCrimson/vietaccent-web/releases/latest/download/app-release.apk";
---

<section id="download" class="py-24" style="background: var(--color-bg);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        Free download
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        Download VietAccent
      </h2>
      <p class="mt-4 text-base" style="color: var(--color-text-secondary); font-family: var(--font-body);">
        Direct APK sideload. No Play Store account required. Free forever.
      </p>
    </div>

    <div class="rounded-2xl border p-8 sm:p-10" style="background: var(--color-surface); border-color: var(--color-border);">
      <!-- Primary CTA -->
      <div class="text-center mb-8">
        <a
          href={APK_URL}
          id="main-download-apk"
          download
          class="inline-flex items-center gap-3 text-white font-bold px-10 py-4 rounded-lg text-lg transition-all duration-150 hover:-translate-y-0.5"
          style="background: var(--color-primary); font-family: var(--font-display); box-shadow: 0 8px 30px rgba(99,102,241,0.35);"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download APK {version}
        </a>
        <p class="mt-3 text-sm" style="color: var(--color-text-muted); font-family: var(--font-body);">
          Requires Android {minAndroid} or later
        </p>
      </div>

      <!-- Trust signals -->
      <div class="grid sm:grid-cols-3 gap-3 mb-8">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
            iconFill: false, iconColor: "#22C55E",
            label: "Signed release APK", sub: "Built with flutter build apk --release",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>`,
            iconFill: false, iconColor: "var(--color-primary)",
            label: `Version ${version}`, sub: `Released ${releaseDate}`,
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>`,
            iconFill: false, iconColor: "var(--color-accent)",
            label: `Android ${minAndroid}+`, sub: "Minimum API level 23",
          },
        ].map((t) => (
          <div class="flex items-start gap-3 rounded-xl p-4 border"
            style="background: var(--color-surface-alt); border-color: var(--color-border);">
            <svg class="w-5 h-5 mt-0.5 shrink-0" fill={t.iconFill ? "currentColor" : "none"} stroke={t.iconFill ? undefined : "currentColor"} viewBox="0 0 24 24" style={`color: ${t.iconColor};`} set:html={t.icon}></svg>
            <div>
              <p class="text-sm font-semibold" style="font-family: var(--font-display); color: var(--color-text-primary);">{t.label}</p>
              <p class="text-xs mt-0.5" style="color: var(--color-text-muted); font-family: var(--font-body);">{t.sub}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- SHA-256 -->
      <div class="rounded-xl p-4" style="background: var(--color-ink);">
        <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color: #6366F1; font-family: var(--font-display);">
          SHA-256 fingerprint
        </p>
        <div class="flex items-center gap-3">
          <code class="text-xs break-all flex-1 select-all" style="color: #A5B4FC; font-family: var(--font-mono);">{sha256}</code>
          <button id="copy-sha" aria-label="Copy SHA-256" class="shrink-0 transition-colors duration-150" style="color: #6B6B6B;" onmouseover="this.style.color='#A5B4FC'" onmouseout="this.style.color='#6B6B6B'">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </button>
        </div>
        <p class="text-xs mt-2" style="color: #6B6B6B; font-family: var(--font-body);">
          Verify on Windows: <code style="font-family: var(--font-mono); color: #9C9C9C;">certutil -hashfile app-release.apk SHA256</code>
        </p>
      </div>
    </div>

    <!-- Install guide -->
    <div class="mt-12">
      <h3 class="text-lg font-bold mb-6 text-center" style="font-family: var(--font-display); color: var(--color-text-primary);">
        How to install
      </h3>
      <ol class="space-y-5">
        {[
          { n: "1", title: "Download the APK",          detail: 'Tap "Download APK" above. Your browser will save app-release.apk to your Downloads folder.' },
          { n: "2", title: "Allow unknown sources",     detail: "Go to Settings → Apps → Special app access → Install unknown apps, then enable it for your browser or Files app." },
          { n: "3", title: "Open the APK",              detail: 'Find app-release.apk in Downloads and tap it. Tap "Install" when prompted.' },
          { n: "4", title: "Sign in and start learning", detail: "Open VietAccent, sign in with Google, and take the placement quiz to begin your personalised learning path." },
        ].map((s) => (
          <li class="flex gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white"
              style="background: var(--color-primary); font-family: var(--font-display);">
              {s.n}
            </div>
            <div>
              <p class="font-semibold text-sm" style="font-family: var(--font-display); color: var(--color-text-primary);">{s.title}</p>
              <p class="text-sm mt-0.5" style="color: var(--color-text-secondary); font-family: var(--font-body);">{s.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-sha");
  const code = btn?.previousElementSibling?.textContent?.trim();
  btn?.addEventListener("click", () => {
    if (code) navigator.clipboard.writeText(code).then(() => {
      btn.setAttribute("aria-label", "Copied!");
      setTimeout(() => btn.setAttribute("aria-label", "Copy SHA-256"), 2000);
    });
  });
</script>
