---
// Screenshots are placeholders — replace src with real WebP exports from the device.
// Priority order: pronunciation scorer → lesson → phrase explorer → dashboard → any other.

const screenshots = [
  {
    label: "Pronunciation Scoring",
    desc: "Per-syllable AI feedback with tone contour overlay",
    placeholder: "🎤",
    bg: "from-red-600 to-red-800",
  },
  {
    label: "Interactive Lesson",
    desc: "Multiple-choice and fill-in-the-blank exercises",
    placeholder: "📝",
    bg: "from-blue-600 to-blue-800",
  },
  {
    label: "Phrase Explorer",
    desc: "Northern & Southern accent audio + AI explanation",
    placeholder: "🔊",
    bg: "from-green-600 to-green-800",
  },
  {
    label: "Progress Dashboard",
    desc: "XP, streaks, achievements, and weak-point tracking",
    placeholder: "📊",
    bg: "from-violet-600 to-violet-800",
  },
  {
    label: "Lesson Library",
    desc: "9+ lesson types organised by skill level",
    placeholder: "🏫",
    bg: "from-amber-600 to-amber-800",
  },
];
---

<section id="screenshots" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">See it in action</h2>
      <p class="mt-4 text-lg text-slate-500 max-w-2xl mx-auto">
        Five key screens from the app — screenshots will be replaced with real device captures shortly.
      </p>
    </div>

    <div class="flex gap-6 overflow-x-auto pb-4 sm:grid sm:grid-cols-3 lg:grid-cols-5 sm:overflow-visible snap-x snap-mandatory">
      {screenshots.map((s) => (
        <div class="shrink-0 w-48 sm:w-auto snap-center">
          <!-- Device frame -->
          <div class="bg-slate-900 rounded-[1.75rem] p-2.5 shadow-xl">
            <div class="bg-slate-100 rounded-[1.4rem] overflow-hidden aspect-[9/19]">
              <div class={`w-full h-full bg-gradient-to-b ${s.bg} flex flex-col items-center justify-center text-white p-4`}>
                <div class="text-4xl mb-3">{s.placeholder}</div>
                <div class="text-sm font-bold text-center">{s.label}</div>
              </div>
            </div>
          </div>
          <div class="mt-3 text-center">
            <p class="text-sm font-semibold text-slate-800">{s.label}</p>
            <p class="text-xs text-slate-500 mt-0.5">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-slate-400">
      Real screenshots coming soon — captured from Android emulator with device frame applied.
    </p>
  </div>
</section>
