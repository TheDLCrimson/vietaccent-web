---
const screenshots = [
  { src: "/assets/screenshots/pronunciation_result.jpg",    label: "Pronunciation Result",  desc: "Per-syllable score + tone breakdown" },
  { src: "/assets/screenshots/pronunciation_test_page.jpg", label: "Pronunciation Test",    desc: "Record and submit against Hanoi or Saigon" },
  { src: "/assets/screenshots/exercise_page.jpg",           label: "Exercise",              desc: "Interactive lesson exercise" },
  { src: "/assets/screenshots/grammar_page.jpg",            label: "Grammar Notes",         desc: "In-lesson grammar explanations" },
  { src: "/assets/screenshots/vocabulary_page.jpg",         label: "Vocabulary",            desc: "Vocabulary exercise type" },
  { src: "/assets/screenshots/phrase_explorer.jpg",         label: "Phrase Explorer",       desc: "Hanoi & Saigon audio + AI context" },
  { src: "/assets/screenshots/dashboard_page.jpg",          label: "Dashboard",             desc: "Home screen and lesson map" },
  { src: "/assets/screenshots/progress_tracker.jpg",        label: "Progress Tracker",      desc: "XP, streaks, and achievements" },
];
---

<section id="screenshots" class="py-24 overflow-hidden" style="background: var(--color-bg);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-primary); font-family: var(--font-display);">
        Screenshots
      </p>
      <h2 class="text-3xl sm:text-4xl font-black" style="font-family: var(--font-display); color: var(--color-text-primary);">
        See it in action
      </h2>
    </div>
  </div>

  <!-- Full-bleed horizontal scroll -->
  <div class="flex gap-4 overflow-x-auto pb-6 px-4 sm:px-8 lg:px-16 snap-x snap-mandatory scroll-smooth" style="scrollbar-width: none;">
    {screenshots.map((s) => (
      <div class="shrink-0 w-40 sm:w-44 snap-center">
        <!-- Phone frame -->
        <div
          class="rounded-[2rem] p-2 shadow-xl"
          style="background: #13122A; box-shadow: 0 24px 48px rgba(0,0,0,0.2), 0 0 0 1px rgba(255,255,255,0.06);"
        >
          <div class="rounded-[1.6rem] overflow-hidden aspect-[9/19] bg-black">
            <img
              src={s.src}
              alt={s.label + " — VietAccent app screenshot"}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>
        <!-- Label -->
        <div class="mt-3 text-center px-1">
          <p class="text-sm font-semibold" style="font-family: var(--font-display); color: var(--color-text-primary);">{s.label}</p>
          <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">{s.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Hide scrollbar across browsers */
  div[class*="overflow-x-auto"]::-webkit-scrollbar { display: none; }
</style>
